# =================================================================
# NAPWC Accomplishment Report Generator — Backend Environment Configuration
# =================================================================

# Server port (Render, Railway, and Cloud Run provide this dynamically)
PORT=5000

# Environment mode: 'development' or 'production'
# When set to 'production', cookies are marked 'secure: true' (requires HTTPS).
NODE_ENV=production

# Session cookie encryption secret (replace with a long, random string in production)
SESSION_SECRET=napwc_super_secret_cookie_key_replace_in_production_2026

# Optional: Set ONLY if your frontend is hosted separately (e.g. Vercel / Netlify).
# If hosting frontend & backend together on the same server, leave this commented out or empty.
# FRONTEND_URL=https://your-frontend-domain.com

# -----------------------------------------------------------------
# Google Cloud OAuth 2.0 Credentials (Required for Google Drive Integration)
# -----------------------------------------------------------------
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Select or create a project.
# 3. Enable the "Google Drive API" under APIs & Services > Library.
# 4. Configure the "OAuth consent screen" (External or Internal).
# 5. Under "Credentials", create an "OAuth 2.0 Client ID" (Web application).
# 6. Add Authorized JavaScript Origins:
#      - Local: http://localhost:5000 (and http://localhost:5173 for Vite dev)
#      - Production: https://your-production-domain.com
# 7. Add Authorized Redirect URIs:
#      - Local: http://localhost:5000/api/auth/google/callback
#      - Production: https://your-production-domain.com/api/auth/google/callback
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
